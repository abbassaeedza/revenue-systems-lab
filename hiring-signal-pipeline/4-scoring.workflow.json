      "parameters": {
        "jsCode": "\nconst total = items.length;\nconst tier1 = items.filter(function (i) { return i.json.tier === 1; }).length;\nconst tier2 = items.filter(function (i) { return i.json.tier === 2; }).length;\nconst tier3 = items.filter(function (i) { return i.json.tier === 3; }).length;\nconst month = new Date().toISOString().slice(0, 7) + '-01';\nconst dbPayload = { workflow_name: 'Scoring', run_started_at: new Date().toISOString(), run_finished_at: new Date().toISOString(), status: 'success', items_processed: { hiring_contacts_total: total, tier1: tier1, tier2: tier2, tier3: tier3 } };\nreturn [{ json: { dbPayloadJson: JSON.stringify(dbPayload), month: month } }];\n"
      },
