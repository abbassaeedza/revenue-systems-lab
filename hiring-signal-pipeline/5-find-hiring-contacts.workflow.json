      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst registryRow = $('Get Uncontacted Hiring Companies').item.json;\nconst raw = items[0].json;\nconst people = raw.people || [];\nconst hasMatch = people.length > 0;\nreturn [{ json: {\n  hasMatch,\n  personId: hasMatch ? people[0].id : null,\n  companyId: registryRow.company_id,\n  domain: registryRow.domain\n} }];\n"
      }
    },
