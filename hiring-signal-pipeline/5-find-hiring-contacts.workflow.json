    {
      "id": "31f21416-6d66-40e5-89fa-820af229a04f",
      "name": "Build Contact Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst matchData = $('Check Has Match').first().json;\nconst raw = items[0].json;\nconst p = raw.person || {};\n\nconst PRIMARY_TITLES = ['founder', 'co-founder', 'ceo', 'chief executive officer', 'owner', 'president'];\nfunction classifyTitle(title) {\n  if (!title) return 'reject';\n  const t = title.toLowerCase();\n  if (PRIMARY_TITLES.some(function (k) { return t.indexOf(k) !== -1; })) return 'primary';\n  return 'secondary';\n}\n\nconst hasEmail = !!p.email;\nconst contact = {\n  company_id: matchData.companyId,\n  first_name: p.first_name || null,\n  last_name: p.last_name || null,\n  full_name: p.name || null,\n  title: p.title || null,\n  title_class: classifyTitle(p.title),\n  linkedin_url: p.linkedin_url || null,\n  sources: ['hiring'],\n  enriched_at: new Date().toISOString()\n};\nif (hasEmail) {\n  contact.email = p.email.toLowerCase().trim();\n  contact.email_status = 'pending';\n} else {\n  contact.email_status = 'not_found';\n}\n\nreturn [{ json: { contactPayloadJson: JSON.stringify(contact), foundEmail: hasEmail, foundContact: !!p.name } }];\n"
      }
    },
