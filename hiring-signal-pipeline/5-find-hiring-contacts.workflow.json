        "language": "javaScript",
        "jsCode": "\nconst total = items.length;\nconst nowIso = new Date().toISOString();\nconst runStartedAt = $('Capture Start Time').first().json.runStartedAt;\nconst month = new Date().toISOString().slice(0, 7) + '-01';\nconst dbPayload = { workflow_name: 'Find Hiring Contacts', run_started_at: nowIso, run_finished_at: nowIso, status: 'success', items_processed: { companies_checked: total } };\nreturn [{ json: { dbPayloadJson: JSON.stringify(dbPayload), month: month, total: total, runStartedAt: runStartedAt } }];\n"
      }
