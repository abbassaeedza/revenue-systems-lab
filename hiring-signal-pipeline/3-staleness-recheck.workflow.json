  "nodes": [
    {
      "id": "a40708d5-6f58-4efb-92c0-b631f9e53c40",
      "name": "Sticky Note 8c959baa",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        608,
        464
      ],
      "parameters": {
        "content": "## Staleness Recheck (daily) - targeted one-time TheirStack re-check for the non-ATS ~90%\nThe ATS Poller tracks closed_at for ATS-hosted postings for free forever. Non-ATS postings\n(ats=theirstack, ~90% of volume, mostly LinkedIn/Indeed) never get re-verified after weekly\ndiscovery, so closed_at can stay permanently null even after the real job closed, letting a\nstale stale_posting signal (Scoring, 45-day threshold) persist forever on a dead posting.\n\nFix: once, at the exact moment a posting crosses 45 days open (first_seen <= today-45,\nstale_checked_at still null), call TheirStack job_id_or for that ONE job (1 credit, confirmed\nlive 2026-09-22 - response has data[].closed_at, null data or a non-null closed_at both mean\nclosed). Sets stale_checked_at regardless of outcome so it is never re-checked again - this is\na one-time correction at the signal boundary, not continuous polling, per the credit-efficiency\nstanding rule. ponytail: capped 50 jobs/run - same cap pattern as Find Hiring Contacts.\n\nTouches hiring-source data but never increments contacts_sourced (a status refresh, not new\nvolume) - same non-incrementing Source Stats resync pattern as the ATS Poller.",
        "color": 4
      }
    },
    {
      "id": "b64260f2-608a-426a-8194-9bf578c6a02a",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        464
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 4
            }
          ]
        }
      }
