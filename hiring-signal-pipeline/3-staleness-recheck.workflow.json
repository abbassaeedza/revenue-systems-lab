    {
      "id": "acbc9431-4988-4e6e-ae73-dc5a5b90c770",
      "name": "Compute 45-Day Cutoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        464
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst today = new Date();\nconst cutoff = new Date(today.getTime() - 45 * 24 * 60 * 60 * 1000);\nreturn [{ json: { cutoffDate: cutoff.toISOString().slice(0, 10), todayDate: today.toISOString().slice(0, 10) } }];\n"
      }
    },
