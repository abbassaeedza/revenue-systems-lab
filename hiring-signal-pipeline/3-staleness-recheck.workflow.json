      "name": "Build Update Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst registryRow = $('Get Jobs Crossing Threshold').item.json;\nconst today = $('Compute 45-Day Cutoff').first().json.todayDate;\nconst raw = items[0].json || {};\nconst data = raw.data || [];\nconst stillOpen = data.length > 0 && !data[0].closed_at;\nconst update = { stale_checked_at: today };\nif (!stillOpen) {\n  update.closed_at = (data[0] && data[0].closed_at) ? String(data[0].closed_at).slice(0, 10) : today;\n}\nreturn [{ json: { jobId: registryRow.id, updatePayloadJson: JSON.stringify(update), reclosed: !stillOpen } }];\n"
      }
    },
