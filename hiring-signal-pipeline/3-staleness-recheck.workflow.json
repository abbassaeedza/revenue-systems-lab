      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst total = items.length;\nconst nowIso = new Date().toISOString();\nconst month = new Date().toISOString().slice(0, 7) + '-01';\nconst dbPayload = { workflow_name: 'Staleness Recheck', run_started_at: nowIso, run_finished_at: nowIso, status: 'success', items_processed: { jobs_rechecked: total } };\nreturn [{ json: { dbPayloadJson: JSON.stringify(dbPayload), month } }];\n"
      }
