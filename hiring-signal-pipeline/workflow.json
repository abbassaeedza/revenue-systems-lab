      "parameters": {
        "jsCode": "\nconst total = items.length;\nconst atsMatched = items.filter(i => i.json.hasAtsSlug).length;\nconst rate = total > 0 ? Math.round((atsMatched / total) * 1000) / 10 : 0;\nconst month = new Date().toISOString().slice(0, 7) + '-01';\nconst statsPayload = { p_source: 'hiring', p_month: month, p_contacts_sourced: total };\nreturn [{ json: { total, atsMatched, rate, month, statsPayloadJson: JSON.stringify(statsPayload) } }];\n"
      },
