    {
      "parameters": {
        "jsCode": "\nconst norm = $('Normalize And Extract ATS').all();\nconst comp = $('Upsert Company').all();\nconst out = [];\nfor (let i = 0; i < norm.length; i++) {\n  const n = norm[i].json;\n  const companyId = (comp[i] && comp[i].json && comp[i].json.id) ? comp[i].json.id : null;\n  const today = new Date().toISOString().slice(0, 10);\n  const jobPosting = {\n    company_id: companyId,\n    ats: n.ats,\n    external_id: n.externalId,\n    title: n.jobTitle,\n    location: n.location,\n    description: n.description,\n    matched_tech: n.matchedTech,\n    last_seen: today\n  };\n  const atsPayload = n.hasAtsSlug ? {\n    company_id: companyId,\n    ats: n.ats,\n    slug: n.atsSlug,\n    board_url: n.boardUrl,\n    active: true\n  } : null;\n  out.push({ json: {\n    jobPostingPayloadJson: JSON.stringify(jobPosting),\n    atsPayloadJson: atsPayload ? JSON.stringify(atsPayload) : null,\n    hasAtsSlug: n.hasAtsSlug\n  }});\n}\nreturn out;\n"
      },
