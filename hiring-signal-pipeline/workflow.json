    {
      "parameters": {
        "jsCode": "\nfunction normalizeDomain(d) {\n  if (!d) return null;\n  let s = String(d).toLowerCase().trim();\n  s = s.replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0];\n  return s || null;\n}\nfunction employeeBand(n) {\n  if (n === null || n === undefined) return null;\n  if (n <= 10) return '1-10';\n  if (n <= 50) return '11-50';\n  if (n <= 200) return '51-200';\n  if (n <= 500) return '201-500';\n  return '500+';\n}\nfunction extractAts(urls) {\n  for (const raw of urls) {\n    if (!raw) continue;\n    let m;\n    if (m = raw.match(/(?:job-boards|boards)\\.greenhouse\\.io\\/([^\\/?]+)/i)) {\n      return { ats: 'greenhouse', slug: m[1], boardUrl: 'https://boards-api.greenhouse.io/v1/boards/' + m[1] + '/jobs?content=true' };\n    }\n    if (m = raw.match(/jobs\\.lever\\.co\\/([^\\/?]+)/i)) {\n      return { ats: 'lever', slug: m[1], boardUrl: 'https://api.lever.co/v0/postings/' + m[1] };\n    }\n    if (m = raw.match(/jobs\\.ashbyhq\\.com\\/([^\\/?]+)/i)) {\n      return { ats: 'ashby', slug: m[1], boardUrl: 'https://api.ashbyhq.com/posting-api/job-board/' + m[1] + '?includeCompensation=true' };\n    }\n    if (m = raw.match(/^https?:\\/\\/([^.\\/]+)\\.recruitee\\.com/i)) {\n      return { ats: 'recruitee', slug: m[1], boardUrl: 'https://' + m[1] + '.recruitee.com/api/offers' };\n    }\n    if (m = raw.match(/jobs\\.workable\\.com\\/view\\/[^\\/]+\\/.*-at-([a-z0-9-]+)(?:[?].*)?$/i)) {\n      return { ats: 'workable', slug: m[1], boardUrl: 'https://apply.workable.com/api/v1/widget/accounts/' + m[1] + '?details=true' };\n    }\n  }\n  return { ats: null, slug: null, boardUrl: null };\n}\nconst TECH_KEYWORDS = ['React Native', 'Flutter', 'Unity', 'Unreal', 'Swift', 'Kotlin', 'iOS', 'Android', 'mobile app'];\nfunction matchedTech(desc) {\n  if (!desc) return [];\n  return TECH_KEYWORDS.filter(k => new RegExp(k.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), 'i').test(desc));\n}\n\nconst out = [];\nfor (const item of items) {\n  const job = item.json;\n  const domain = normalizeDomain(job.company_domain);\n  if (!domain) continue;\n  const co = job.company_object || {};\n  const atsInfo = extractAts([job.final_url, job.url, job.source_url]);\n  const companyPayload = { domain, country: job.country_code || 'US' };\n  if (co.name) companyPayload.name = co.name;\n  if (co.employee_count !== undefined && co.employee_count !== null) {\n    companyPayload.employee_count = co.employee_count;\n    companyPayload.employee_band = employeeBand(co.employee_count);\n  }\n  if (co.industry) companyPayload.industry = co.industry;\n  if (co.linkedin_url) companyPayload.linkedin_url = co.linkedin_url;\n  companyPayload.last_seen = new Date().toISOString();\n\n  out.push({ json: {\n    domain,\n    companyPayloadJson: JSON.stringify(companyPayload),\n    jobTitle: job.job_title || null,\n    location: job.short_location || job.location || null,\n    description: job.description || null,\n    matchedTech: matchedTech(job.description),\n    externalId: String(job.id),\n    ats: atsInfo.ats || 'theirstack',\n    atsSlug: atsInfo.slug,\n    boardUrl: atsInfo.boardUrl,\n    hasAtsSlug: !!atsInfo.slug\n  }});\n}\nreturn out;\n"
      },
